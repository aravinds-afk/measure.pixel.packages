# ---------------------------------------------------------------------------
# XpressU — environment configuration
# Copy to `.env` and fill in. Only EXPO_PUBLIC_* values are bundled into the
# mobile app, so NEVER put secret keys (OpenAI, Supabase service role,
# RevenueCat secret) in an EXPO_PUBLIC_* variable.
# ---------------------------------------------------------------------------

# "mock" = on-device mock AI (no network, no keys). "backend" = call the
# secure endpoint below. If unset: "backend" when EXPO_PUBLIC_AI_ENDPOINT is
# set, otherwise "mock".
EXPO_PUBLIC_AI_MODE=mock

# Full URL of the reply-generation endpoint.
#   Supabase:   https://<project-ref>.supabase.co/functions/v1/generate-replies
#   Local dev:  http://<your-LAN-IP>:8787/generate-replies  (npm run dev:server)
EXPO_PUBLIC_AI_ENDPOINT=

# Supabase (public values — safe to ship; protected by Row Level Security).
# Leave empty to run without auth.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (used once RevenueCat is wired in).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY (used by `npm run dev:server`; for Supabase set them with
# `supabase secrets set`). Never exposed to the app bundle.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEV_SERVER_PORT=8787
