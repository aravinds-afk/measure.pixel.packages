# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# Meta / WhatsApp Cloud API (one Meta app can serve many client numbers)
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# Per-tenant secrets, referenced by name from tenants/*.json
WA_TOKEN_MEASURE_PIXEL=
API_KEY_MEASURE_PIXEL=
WA_TOKEN_FITWITHNEHA=
API_KEY_FITWITHNEHA=

# Server
ADMIN_API_KEY=choose-a-long-random-string
PORT=3000
DB_PATH=data/agent.db
TENANTS_DIR=tenants
TICK_MS=30000
NODE_ENV=production
