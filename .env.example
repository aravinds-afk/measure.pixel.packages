# --- Required ---------------------------------------------------------------
# Session signing secret, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Database. Local file for development; Turso/libSQL URL in production.
DATABASE_URL=file:./data/local.db
# DATABASE_AUTH_TOKEN=            # required for libsql:// (Turso) URLs

# Public base URL, used for shareable quotation links and the Sheets "PDF or Secure Link" column.
APP_URL=http://localhost:3000

# --- Google Sheets (optional until configured) --------------------------------
# Service account with access to the spreadsheet (share the sheet with this email as Editor).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PKCS#8 private key from the service-account JSON ("private_key"). Keep the \n escapes.
GOOGLE_PRIVATE_KEY=
# The long ID in the spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Protects /api/cron/sync (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# --- Automatic audit: Instagram (optional) -------------------------------------
# Apify API token (console.apify.com → Settings → Integrations). Runs the
# "apify/instagram-profile-scraper" actor; billed per run on your Apify plan.
APIFY_TOKEN=

# --- Morning brief (optional) --------------------------------------------------
# Claude API key (platform.claude.com). The Today page works without it; with it,
# "Write today's brief" asks Claude for a short daily brief (cached per day).
ANTHROPIC_API_KEY=
